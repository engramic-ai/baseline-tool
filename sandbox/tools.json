{
  "notes": [
    "Install catalogue for disposable Windows Sandbox environments. This is about getting a tool ONTO a machine;",
    "how Engramic Baseline DETECTS it lives in config/ai-tools.json and is deliberately kept separate.",
    "install.type: winget (id, optional source), script (PowerShell run elevated), vscode (extension ids; needs the vscode tool), npm (global package; needs the node tool).",
    "exe: process image the tool runs as, used to launch it after install (searched under Program Files, LocalAppData and WindowsApps).",
    "manual: true means the tool cannot be installed unattended (licence, sign-in or no public installer); it is reported as not testable rather than skipped silently.",
    "winget ids are best effort and drift: an id that fails is reported per tool, not fatal."
  ],
  "lastReviewed": "2026-09-22",
  "tools": [
    { "id": "vscode",  "name": "Visual Studio Code", "helper": true,
      "install": { "type": "winget", "id": "Microsoft.VisualStudioCode", "args": ["--override", "/VERYSILENT /NORESTART /MERGETASKS=!runcode,addtopath"] },
      "exe": "Code.exe", "cli": "code.cmd" },
    { "id": "node",    "name": "Node.js LTS", "helper": true,
      "install": { "type": "winget", "id": "OpenJS.NodeJS.LTS" }, "exe": "node.exe" },
    { "id": "pwsh",    "name": "PowerShell 7", "helper": true,
      "install": { "type": "winget", "id": "Microsoft.PowerShell" }, "exe": "pwsh.exe" },

    { "id": "claude-desktop",
      "install": { "type": "winget", "id": "Anthropic.Claude" }, "exe": "claude.exe" },
    { "id": "claude-code",
      "install": { "type": "script", "command": "Invoke-RestMethod https://claude.ai/install.ps1 | Invoke-Expression" }, "exe": "claude.exe" },
    { "id": "chatgpt-desktop",
      "install": { "type": "winget", "id": "9NT1R1C2HH7J", "source": "msstore" }, "exe": "ChatGPT.exe" },
    { "id": "chatgpt-classic", "manual": true, "reason": "superseded by the ChatGPT app; no current installer" },
    { "id": "openai-codex-cli",
      "install": { "type": "npm", "package": "@openai/codex" }, "dependsOn": ["node"], "exe": "node.exe" },
    { "id": "github-copilot-vscode",
      "install": { "type": "vscode", "extensions": ["GitHub.copilot"] }, "dependsOn": ["vscode"], "exe": "Code.exe" },
    { "id": "github-copilot-cli",
      "install": { "type": "npm", "package": "@github/copilot" }, "dependsOn": ["node"], "exe": "node.exe" },
    { "id": "microsoft-copilot",
      "install": { "type": "winget", "id": "9NHT9RB2F4HD", "source": "msstore" }, "exe": "Copilot.exe" },
    { "id": "microsoft-365-copilot", "manual": true, "reason": "needs a Microsoft 365 licence and sign-in" },
    { "id": "cursor",
      "install": { "type": "winget", "id": "Anysphere.Cursor" }, "exe": "Cursor.exe" },
    { "id": "windsurf",
      "install": { "type": "winget", "id": "Codeium.Windsurf" }, "exe": "Windsurf.exe" },
    { "id": "gemini-cli",
      "install": { "type": "npm", "package": "@google/gemini-cli" }, "dependsOn": ["node"], "exe": "node.exe" },
    { "id": "perplexity-desktop",
      "install": { "type": "winget", "id": "9NTDCDJR1GMH", "source": "msstore" }, "exe": "Perplexity.exe" },
    { "id": "cline",
      "install": { "type": "vscode", "extensions": ["saoudrizwan.claude-dev"] }, "dependsOn": ["vscode"], "exe": "Code.exe" },
    { "id": "roo-code",
      "install": { "type": "vscode", "extensions": ["RooVeterinaryInc.roo-cline"] }, "dependsOn": ["vscode"], "exe": "Code.exe" },
    { "id": "continue",
      "install": { "type": "vscode", "extensions": ["Continue.continue"] }, "dependsOn": ["vscode"], "exe": "Code.exe" },
    { "id": "amazon-q-developer",
      "install": { "type": "vscode", "extensions": ["AmazonWebServices.amazon-q-vscode"] }, "dependsOn": ["vscode"], "exe": "Code.exe" },
    { "id": "jetbrains-junie-cli", "manual": true, "reason": "no public unattended installer" },
    { "id": "ollama",
      "install": { "type": "winget", "id": "Ollama.Ollama" }, "exe": "ollama app.exe" },
    { "id": "lm-studio",
      "install": { "type": "winget", "id": "ElementLabs.LMStudio" }, "exe": "LM Studio.exe" }
  ]
}

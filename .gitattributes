* text=auto
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.json text eol=crlf
*.md   text eol=lf
*.ico  binary
*.ttf  binary
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.slnx    text eol=crlf
*.slnf    text eol=crlf
# Bytes the desktop app's build carries into its output: the XAML compiler writes a checksum of each .xaml
# file into the generated code (and so into the PDB and the assembly), and a manifest is embedded as it is.
# Pinned, so that a checkout on any machine builds the same files as CI's.
*.xaml     text eol=crlf
*.manifest text eol=crlf

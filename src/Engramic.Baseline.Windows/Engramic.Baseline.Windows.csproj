<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Windows implementations of the primitives, through explicit Win32 calls that CsWin32 generates
    from NativeMethods.txt. AOT-clean. The minimum Windows version is set in Directory.Build.targets.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <!--
    No runtime marshalling: every native call passes only blittable values, as CsWin32 generates them with
    "allowMarshaling": false, so a call compiles to a direct one under Native AOT, and a signature that would need
    marshalling fails the build (CA1420) rather than adding a stub at run time.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engramic.Baseline.Platform\Engramic.Baseline.Platform.csproj" />
  </ItemGroup>
</Project>

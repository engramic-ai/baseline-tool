<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Proves that the AOT-clean libraries compile with Native AOT and run. Each library is rooted whole,
    so a trim or AOT warning anywhere in one fails the publish, not only on the path Main takes.
    dotnet publish tests/AotCanary -c Release -r win-x64, then run the AotCanary.exe it writes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Every warning on its own line, and each one an error. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engramic.Baseline.Model\Engramic.Baseline.Model.csproj" />
    <ProjectReference Include="..\..\src\Engramic.Baseline.Platform\Engramic.Baseline.Platform.csproj" />
    <ProjectReference Include="..\..\src\Engramic.Baseline.Engine\Engramic.Baseline.Engine.csproj" />
    <ProjectReference Include="..\..\src\Engramic.Baseline.Windows\Engramic.Baseline.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Engramic.Baseline.Model" />
    <TrimmerRootAssembly Include="Engramic.Baseline.Platform" />
    <TrimmerRootAssembly Include="Engramic.Baseline.Engine" />
    <TrimmerRootAssembly Include="Engramic.Baseline.Windows" />
  </ItemGroup>
</Project>

{
  "notes": "Prefix and key-name patterns used to CLASSIFY (never validate) credentials found in AI/MCP client config. Classify only: no network calls, no token validation. 'unknown' is a first-class, non-embarrassing result - a wrong provider label is worse than no label. Admin-overridable: a file of the same name in %ProgramData%\\EngramicBaseline\\config replaces this one.",
  "lastReviewed": "2026-09-21",
  "prefixes": [
    {
      "pattern": "github_pat_",
      "provider": "github",
      "type": "pat-fine-grained"
    },
    {
      "pattern": "ghp_",
      "provider": "github",
      "type": "pat-classic"
    },
    {
      "pattern": "gho_",
      "provider": "github",
      "type": "oauth"
    },
    {
      "pattern": "ghs_",
      "provider": "github",
      "type": "server-token"
    },
    {
      "pattern": "glpat-",
      "provider": "gitlab",
      "type": "pat"
    },
    {
      "pattern": "sk-ant-",
      "provider": "anthropic",
      "type": "api-key"
    },
    {
      "pattern": "sk-proj-",
      "provider": "openai",
      "type": "api-key"
    },
    {
      "pattern": "sk-",
      "provider": "openai",
      "type": "api-key"
    },
    {
      "pattern": "xoxb-",
      "provider": "slack",
      "type": "bot-token"
    },
    {
      "pattern": "xoxp-",
      "provider": "slack",
      "type": "user-token"
    },
    {
      "pattern": "xapp-",
      "provider": "slack",
      "type": "app-token"
    },
    {
      "pattern": "AKIA",
      "provider": "aws",
      "type": "access-key-id"
    },
    {
      "pattern": "AIza",
      "provider": "google",
      "type": "api-key"
    },
    {
      "pattern": "ya29.",
      "provider": "google",
      "type": "oauth"
    },
    {
      "pattern": "npm_",
      "provider": "npm",
      "type": "token"
    },
    {
      "pattern": "dop_v1_",
      "provider": "digitalocean",
      "type": "token"
    },
    {
      "pattern": "pplx-",
      "provider": "perplexity",
      "type": "api-key"
    },
    {
      "pattern": "figd_",
      "provider": "figma",
      "type": "token"
    },
    {
      "pattern": "hf_",
      "provider": "huggingface",
      "type": "token"
    }
  ],
  "keyNames": [
    {
      "match": "*GITHUB*TOKEN*",
      "provider": "github",
      "type": "unknown"
    },
    {
      "match": "*OPENAI*API*KEY*",
      "provider": "openai",
      "type": "api-key"
    },
    {
      "match": "*ANTHROPIC*API*KEY*",
      "provider": "anthropic",
      "type": "api-key"
    },
    {
      "match": "*SLACK*TOKEN*",
      "provider": "slack",
      "type": "unknown"
    },
    {
      "match": "*AWS*SECRET*ACCESS*KEY*",
      "provider": "aws",
      "type": "secret-access-key"
    },
    {
      "match": "*BRAVE*API*KEY*",
      "provider": "brave",
      "type": "api-key"
    },
    {
      "match": "*API*KEY*",
      "provider": "unknown",
      "type": "api-key"
    },
    {
      "match": "*ACCESS*TOKEN*",
      "provider": "unknown",
      "type": "access-token"
    },
    {
      "match": "*AUTH*TOKEN*",
      "provider": "unknown",
      "type": "unknown"
    },
    {
      "match": "*_TOKEN",
      "provider": "unknown",
      "type": "unknown"
    },
    {
      "match": "*SECRET*",
      "provider": "unknown",
      "type": "unknown"
    },
    {
      "match": "*PASSWORD*",
      "provider": "unknown",
      "type": "password"
    },
    {
      "match": "*PASSWD*",
      "provider": "unknown",
      "type": "password"
    }
  ],
  "referencePatterns": [
    "^\\$\\{env:",
    "^\\$\\{input:",
    "^\\$\\{.+\\}$",
    "^%[A-Za-z0-9_]+%$"
  ]
}
